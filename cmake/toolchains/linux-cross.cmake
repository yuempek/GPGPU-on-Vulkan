set(CMAKE_SYSTEM_NAME Linux)

if(NOT CMAKE_SYSTEM_PROCESSOR)
    set(CMAKE_SYSTEM_PROCESSOR x86_64)
endif()

get_filename_component(CROSS_TOOL_DIR "${CMAKE_CURRENT_LIST_DIR}/../../tools/cross" ABSOLUTE)

if(CMAKE_SYSTEM_PROCESSOR STREQUAL "aarch64" OR CMAKE_SYSTEM_PROCESSOR STREQUAL "arm64")
    set(CMAKE_SYSTEM_PROCESSOR aarch64)
    set(CMAKE_C_COMPILER   "${CROSS_TOOL_DIR}/aarch64-linux-gcc.cmd")
    set(CMAKE_CXX_COMPILER "${CROSS_TOOL_DIR}/aarch64-linux-g++.cmd")
elseif(CMAKE_SYSTEM_PROCESSOR STREQUAL "arm" OR CMAKE_SYSTEM_PROCESSOR STREQUAL "armhf" OR CMAKE_SYSTEM_PROCESSOR STREQUAL "armv7l")
    set(CMAKE_SYSTEM_PROCESSOR arm)
    set(CMAKE_C_COMPILER   "${CROSS_TOOL_DIR}/armhf-linux-gcc.cmd")
    set(CMAKE_CXX_COMPILER "${CROSS_TOOL_DIR}/armhf-linux-g++.cmd")
elseif(CMAKE_SYSTEM_PROCESSOR STREQUAL "x86" OR CMAKE_SYSTEM_PROCESSOR STREQUAL "i686" OR CMAKE_SYSTEM_PROCESSOR STREQUAL "i386")
    set(CMAKE_SYSTEM_PROCESSOR x86)
    set(CMAKE_C_COMPILER   "${CROSS_TOOL_DIR}/x86-linux-gcc.cmd")
    set(CMAKE_CXX_COMPILER "${CROSS_TOOL_DIR}/x86-linux-g++.cmd")
else()
    set(CMAKE_SYSTEM_PROCESSOR x86_64)
    set(CMAKE_C_COMPILER   "${CROSS_TOOL_DIR}/x86_64-linux-gcc.cmd")
    set(CMAKE_CXX_COMPILER "${CROSS_TOOL_DIR}/x86_64-linux-g++.cmd")
endif()

set(CMAKE_AR     "${CROSS_TOOL_DIR}/zig-ar.cmd" CACHE FILEPATH "Archiver")
set(CMAKE_RANLIB "${CROSS_TOOL_DIR}/zig-ranlib.cmd" CACHE FILEPATH "Ranlib")
